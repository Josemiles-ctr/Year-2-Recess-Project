# Flask Web Server Configurations
FLASK_APP=src/app.py
FLASK_DEBUG=True
PORT=5000

# Secret Key (used for cryptographically signing Flask session cookies)
SECRET_KEY=replace-with-a-long-random-secret

# Google Gemini API Key (required for RAG chatbot)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
