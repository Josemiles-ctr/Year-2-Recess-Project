# Flask Web Server Configurations
FLASK_APP=src/app.py
FLASK_DEBUG=True
PORT=5000

# Secret Key (used for cryptographically signing Flask session cookies)
SECRET_KEY=os.environ.get('SECRET_KEY')

# Large Language Model (LLM) Integration Settings
# Options: 'gemini' (Google Generative AI) or 'openai' (OpenAI GPT Models)
LLM_PROVIDER=os.environ.get('LLM_PROVIDER', 'gemini')
GEMINI_API_KEY=os.environ.get('GEMINI_API_KEY')
# Insert your respective provider API key here.
# If left blank, the application will automatically fall back to its
# local, rule-based diagnostic narrative and explanation engine.
LLM_API_KEY=os.environ.get('LLM_API_KEY')